# ============================================
# TradeMaster - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ---- App ----
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ---- Binance API ----
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://trademaster:your_password_here@localhost:5432/trademaster
POSTGRES_USER=trademaster
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=trademaster
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Authentication ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ---- JWT ----
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Trading ----
PAPER_MODE=true
# Real-capital orders remain impossible until all controls below are configured
# and Binance Spot native protection plus reconciliation are passing.
# Never enable this before Testnet and the controlled real-capital verification.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ARM_CODE=
LIVE_TRADING_ARM_TTL_MINUTES=15
LIVE_TRADING_MAX_NOTIONAL_PER_ORDER=100
LIVE_TRADING_MAX_DAILY_NOTIONAL=300
LIVE_TRADING_RECONCILIATION_MAX_AGE_SECONDS=45
LIVE_TRADING_TESTNET_VERIFICATION_MAX_AGE_DAYS=30
# Assets allowed without a tracked LIVE position (quote balance and fee token).
LIVE_TRADING_ALLOWED_ACCOUNT_ASSETS=USDT,BNB
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
TRADING_MAX_RISK_PER_TRADE=0.02
TRADING_MAX_PORTFOLIO_EXPOSURE=0.60
TRADING_MAX_SINGLE_ASSET_EXPOSURE=0.30
TRADING_MAX_DAILY_DRAWDOWN=0.03
TRADING_MAX_WEEKLY_DRAWDOWN=0.07
TRADING_MAX_MONTHLY_DRAWDOWN=0.10
TRADING_MAX_TOTAL_DRAWDOWN=0.15
TRADING_KELLY_FRACTION=0.15
