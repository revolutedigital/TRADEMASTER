FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir "."

COPY . .

RUN mkdir -p /data/microstructure-v1

CMD ["python", "-m", "scripts.research.record_microstructure", "--root", "/data/microstructure-v1", "--include-spot-trades"]
